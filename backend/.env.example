PORT=5000
HOST=127.0.0.1
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=flavoriz
DB_USER=root
DB_PASSWORD=

DATABASE_URL="mysql://root:@localhost/flavoriz"

